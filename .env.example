# ============================================================
# JobBot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=rootpassword

# ── AI Provider (FREE) ────────────────────────────────────────────────────────
# OPTION 1: Groq — free cloud AI, no credit card needed
# Get key: https://console.groq.com/ → Sign Up → API Keys → Create Key
AI_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: change Groq model (all free)
# GROQ_MODEL=llama-3.3-70b-versatile   <- best quality (default)
# GROQ_MODEL=llama-3.1-8b-instant      <- fastest

# OPTION 2: Ollama — runs locally, 100% offline, always free
# Install: https://ollama.com/ then run: ollama pull llama3.2
# AI_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── Email Notifications (optional, free via Gmail) ────────────────────────────
# Get email alerts when new high-match jobs are found.
# Gmail setup (one-time):
#   1. Enable 2FA: myaccount.google.com/security
#   2. Create App Password: myaccount.google.com/apppasswords
#   3. Fill in below
NOTIFY_ENABLED=false
NOTIFY_EMAIL=your@email.com
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_HOST=smtp.gmail.com   <- default, change for other providers
# MAIL_PORT=587               <- default

# ── Notes ─────────────────────────────────────────────────────────────────────
# - ANTHROPIC_API_KEY is no longer needed — app uses FREE Groq/Ollama
# - All costs: $0.00
